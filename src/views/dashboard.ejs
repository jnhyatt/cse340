<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Dashboard</h2>
        <p>Name: <%= name %>
        </p>
        <p>Username: <%= email %>
        </p>

        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/users">View registered users</a></p>
            <% } %>

                <h2>My Projects</h2>
                <ul>
                    <% volunteeredProjects.forEach(project=> { %>
                        <li>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                            (<a href="/project/<%= project.project_id %>/unvolunteer">Remove</a>)
                        </li>
                        <% }) %>
                </ul>

    </main>

    <%- include('partials/footer') %>