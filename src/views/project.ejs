<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <%= project.title %>
        </h2>

        <p>Organized by: <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <p>Date: <%= new Date(project.occurs_at).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                day: 'numeric' }) %>
        </p>

        <p>Location: <%= project.location %>
        </p>

        <p>Description: <%= project.description %>
        </p>

        <p>Categories
            <% if (user && user.role_name==='admin' ) { %>
                (<a href="/assign-categories/<%= project.project_id %>">Edit</a>)
                <% } %>
                    :
                    <% categories.forEach((category, index)=> { %>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                        <% if (index < categories.length - 1) { %>,<% } %>
                                <% }) %>
        </p>

        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
            <% } %>

                <% if (user) { %>
                    <% if (isSignedUp) { %>
                        <p>You are signed up for this project.
                            (<a href="/project/<%= project.project_id %>/unvolunteer">Leave</a>)
                        </p>
                        <% } else { %>
                            <p><a href="/project/<%= project.project_id %>/volunteer">Volunteer for this project</a></p>
                            <% } %>
                                <% } %>
    </main>
    <%- include('partials/footer') %>